// ──────────────────────────────────────────────────────────────
// FUTURE PILOT — Firestore Security Rules
// Enterprise-grade multi-tenant data security
// ──────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isCompany() {
      return hasRole('company');
    }

    function isMentor() {
      return hasRole('mentor');
    }

    function isCollege() {
      return hasRole('college');
    }

    // ─── Users Collection ─────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Students Collection ──────────────────────────────────

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isStudent() && request.resource.data.userId == request.auth.uid;
      allow update: if (isStudent() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Companies Collection ─────────────────────────────────

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isCompany() && request.resource.data.userId == request.auth.uid;
      allow update: if (isCompany() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Colleges Collection ──────────────────────────────────

    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if (isCollege() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Mentors Collection ───────────────────────────────────

    match /mentors/{mentorId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if (isMentor() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Projects Collection ──────────────────────────────────

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isCompany() || isAdmin();
      allow update: if isAdmin() || (isCompany() && resource.data.companyId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Applications Collection ──────────────────────────────

    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        isMentor()
      );
      allow create: if isStudent();
      allow update: if isAdmin() || isMentor() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Milestones Collection ────────────────────────────────

    match /milestones/{milestoneId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || isMentor();
      allow delete: if isAdmin();
    }

    // ─── Wallets Collection ───────────────────────────────────
    // CRITICAL: Balance changes MUST go through Cloud Functions

    match /wallets/{walletId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if false; // Only via Cloud Functions
      allow update: if false; // Only via Cloud Functions
      allow delete: if false;
    }

    // ─── Transactions Collection ──────────────────────────────
    // Immutable — write-once via Cloud Functions only

    match /transactions/{transactionId} {
      allow read: if isAdmin() || resource.data.walletId in getAfter(/databases/$(database)/documents/wallets/$(resource.data.walletId)).data.ownerId;
      allow create: if false; // Only via Cloud Functions
      allow update: if false;
      allow delete: if false;
    }

    // ─── Badges Collection ────────────────────────────────────

    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow create: if false; // Only via Cloud Functions
      allow update: if false;
      allow delete: if false;
    }

    // ─── Certificates Collection ──────────────────────────────

    match /certificates/{certId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── Notifications Collection ─────────────────────────────

    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if false; // Only via Cloud Functions
      allow update: if isOwner(resource.data.userId); // Mark as read
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── Audit Logs Collection ────────────────────────────────
    // Completely immutable — append-only via Cloud Functions

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── Platform Settings ────────────────────────────────────

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
